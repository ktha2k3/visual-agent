# Main conversation and scene composition: River DeepSeek
RIVER_BASE_URL=https://api.river.ai/v1
RIVER_API_KEY=replace_with_river_api_key
LLM_MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash
TUTOR_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
VISUALIZATION_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Image description and research only: Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=replace_with_ollama_cloud_api_key
VISION_MODEL=gemma4:31b
RESEARCH_MODEL=gpt-oss:120b
TAVILY_API_KEY=replace_with_tavily_api_key
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Embeddings use the local Ollama daemon independently of chat routing.
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1

# Redis checkpoints and RQ
REDIS_URL=redis://localhost:6379

# Supabase (leave blank for local development mode)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
AUTH_REQUIRED=false
ADMIN_EMAILS=teacher@example.com

# Browser/API security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_MAX_BYTES=26214400
UPLOAD_RETENTION_DAYS=30
DEBUG_STREAM=false
CHAT_DATABASE_PATH=data/chat_history.sqlite3
# Direct PostgreSQL for durable chat sessions/messages. Supabase remains supported.
DATABASE_URL=postgresql://visual_agent:visual_agent@127.0.0.1:5432/visual_agent
APP_TIMEZONE=Asia/Ho_Chi_Minh
# HMAC SHA-256 secret for POST /api/webhooks/knowledge-uploaded.
KNOWLEDGE_WEBHOOK_SECRET=replace_with_a_long_random_secret

# STEM visualization (Manim CE 0.19+ and FFmpeg are required on the worker)
VISUALIZATION_ARTIFACT_DIR=data/visualizations
VISUALIZATION_VERSION=stem-v1
VISUALIZATION_QUALITY=l
VISUALIZATION_RENDER_TIMEOUT=5
VISUALIZATION_RENDERER=cairo
MAX_RENDER_RETRIES=3
VISUALIZATION_MAX_CONCURRENCY=2

# Frontend: put these values in frontend/.env.local
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
