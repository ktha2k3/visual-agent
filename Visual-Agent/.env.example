# Direct Ollama Cloud inference
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=replace_with_ollama_cloud_api_key
TUTOR_MODEL=gemma4:31b
VISION_MODEL=gemma4:31b
RESEARCH_MODEL=gpt-oss:120b
# Dedicated Math-To-Manim reasoning/code-generation model.
OLLAMA_MODEL=gemma4:31b-cloud
VISUALIZATION_MODEL=gemma4:31b-cloud
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Chat/vision stay on Ollama Cloud; embeddings use the local Ollama daemon.
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1

# Redis checkpoints and RQ
REDIS_URL=redis://localhost:6379

# Supabase (leave blank for local development mode)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_EXAM_BUCKET=exam-artifacts
AUTH_REQUIRED=false
ADMIN_EMAILS=teacher@example.com

# Browser/API security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_MAX_BYTES=26214400
UPLOAD_RETENTION_DAYS=30
EXAM_SOURCE_HOSTS=moet.gov.vn,www.moet.gov.vn,vqa.moet.gov.vn,baochinhphu.vn,bcp.cdnchinhphu.vn,xaydungchinhsach.chinhphu.vn,xdcs.cdnchinhphu.vn
DEBUG_STREAM=false
CHAT_DATABASE_PATH=data/chat_history.sqlite3
APP_TIMEZONE=Asia/Ho_Chi_Minh
# HMAC SHA-256 secret for POST /api/webhooks/knowledge-uploaded.
KNOWLEDGE_WEBHOOK_SECRET=replace_with_a_long_random_secret

# STEM visualization (Manim CE 0.19+ and FFmpeg are required on the worker)
VISUALIZATION_ARTIFACT_DIR=data/visualizations
VISUALIZATION_VERSION=stem-v1
VISUALIZATION_QUALITY=l
VISUALIZATION_RENDER_TIMEOUT=300
MAX_RENDER_RETRIES=3
VISUALIZATION_MAX_CONCURRENCY=2

# Frontend: put these values in frontend/.env.local
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
